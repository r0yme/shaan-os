// Shaan Business OS — Prisma schema
// Phase 1: Foundation (auth, RBAC, settings, audit).
// Later phases add CRM, projects, tasks, finance etc. in additive migrations.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// AUTHENTICATION
// ============================================================

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  INACTIVE
}

// Kind distinguishes team members (USER) from portal users (CLIENT).
// Clients are real users of the system so they can authenticate into the portal.
enum UserKind {
  USER
  CLIENT
}

model User {
  id               String     @id @default(cuid())
  name             String?
  email            String?    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  phone            String?
  jobTitle         String?
  kind             UserKind   @default(USER)
  status           UserStatus @default(INVITED)
  lastLoginAt      DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?
  createdBy        String?

  accounts  Account[]
  sessions  Session[]
  roles     UserRole[]
  auditLogs AuditLog[]
  clientProfile     Client?   @relation("ClientPortalUser")
  managedClients    Client[]  @relation("ClientAccountManager")
  assignedLeads     Lead[]    @relation("LeadAssignee")
  managedProjects   Project[] @relation("ProjectManager")
  assignedTasks     Task[]    @relation("TaskAssignee")
  createdTasks      Task[]    @relation("TaskCreator")
  createdInvoices   Invoice[] @relation("InvoiceCreator")
  recordedPayments  Payment[] @relation("PaymentRecorder")
  recordedExpenses  Expense[] @relation("ExpenseRecorder")
  createdConversations Conversation[] @relation("ConversationCreator")
  sentMessages Message[] @relation("MessageSender")
  requestedApprovals Approval[] @relation("ApprovalRequestor")
  decidedApprovals Approval[] @relation("ApprovalDecider")
  timeEntries TimeEntry[] @relation("TimeEntryUser")
  createdCalendarEvents CalendarEvent[] @relation("CalendarEventCreator")
  uploadedFiles SharedFile[] @relation("SharedFileUploader")
  createdContractors Contractor[] @relation("ContractorCreator")
  notifications Notification[] @relation("UserNotifications")

  @@index([email])
  @@index([kind, status])
  @@index([deletedAt])
}

// Auth.js (Prisma adapter) — Account model
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// Auth.js (Prisma adapter) — Session model
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Auth.js (Prisma adapter) — VerificationToken model
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================================
// AUTHORIZATION / RBAC
// ============================================================

model Role {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. OWNER, ADMIN, PROJECT_MANAGER, EMPLOYEE, CLIENT
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique // e.g. clients.view, finance.view
  module      String // e.g. clients, projects, finance
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
}

// ============================================================
// CRM — CLIENTS & LEADS
// ============================================================

enum ClientStatus {
  ACTIVE
  INACTIVE
}

// BUSINESS = a company/agency; INDIVIDUAL = a single person
enum ClientKind {
  BUSINESS
  INDIVIDUAL
}

model Client {
  id               String       @id @default(cuid())
  name             String
  email            String?      @unique
  phone            String?
  company          String?
  website          String?
  address          String?
  notes            String?
  status           ClientStatus @default(ACTIVE)
  kind             ClientKind   @default(BUSINESS)
  // Portal login user (kind = CLIENT) linked to this record, if provisioned.
  portalUserId     String?      @unique
  portalUser       User?        @relation("ClientPortalUser", fields: [portalUserId], references: [id], onDelete: SetNull)
  // Account manager / owner of this account inside the workspace.
  accountManagerId String?
  accountManager   User?        @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  deletedAt        DateTime?

  leads    Lead[]
  projects Project[]
  invoices Invoice[]
  expenses Expense[]
  conversations Conversation[]
  calendarEvents CalendarEvent[] @relation("CalendarEventClient")
  files SharedFile[] @relation("SharedFileClient")

  @@index([status])
  @@index([accountManagerId])
  @@index([deletedAt])
  @@index([createdAt])
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  EMAIL
  CALL
  OUTREACH
  OTHER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

model Lead {
  id         String     @id @default(cuid())
  name       String
  email      String?
  phone      String?
  company    String?
  source     LeadSource @default(OTHER)
  status     LeadStatus @default(NEW)
  // Deal value in minor units (cents for USD). Null = not estimated.
  value      Int?
  notes      String?
  assigneeId String?
  assignee   User?      @relation("LeadAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  // Set when a lead is converted into a client.
  clientId   String?
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deletedAt  DateTime?

  @@index([status])
  @@index([assigneeId])
  @@index([clientId])
  @@index([deletedAt])
  @@index([createdAt])
}

// ============================================================
// PROJECTS
// ============================================================

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
}

model Project {
  id          String         @id @default(cuid())
  name        String
  description String?        @db.Text
  status      ProjectStatus  @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  // Owning client, when the work is for an external customer.
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  // Internal owner / delivery lead inside the workspace.
  managerId   String?
  manager     User?          @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)
  // Budget in minor units (cents for USD). Null = not estimated.
  budget      Int?
  startDate   DateTime?
  deadline    DateTime?
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  milestones Milestone[]

  tasks Task[]

  invoices Invoice[]

  expenses Expense[]

  conversations Conversation[]

  calendarEvents CalendarEvent[] @relation("CalendarEventProject")

  files SharedFile[] @relation("SharedFileProject")

  contractorAssignments ContractorProject[]

  @@index([status])
  @@index([clientId])
  @@index([managerId])
  @@index([deletedAt])
  @@index([createdAt])
}

enum MilestoneStatus {
  PENDING
  COMPLETED
}

model Milestone {
  id          String          @id @default(cuid())
  projectId   String
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?         @db.Text
  status      MilestoneStatus @default(PENDING)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([projectId])
  @@index([status])
}

// ============================================================
// TASKS
// ============================================================

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id             String       @id @default(cuid())
  title          String
  description    String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  // Optional link to a project. Deleting the project removes its tasks.
  projectId      String?
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById    String?
  createdBy      User?        @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  timeEntries    TimeEntry[]  @relation("TimeEntryTask")
  dueDate        DateTime?
  estimatedHours Int?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([assigneeId])
  @@index([deletedAt])
  @@index([createdAt])
}

// ============================================================
// BILLING — INVOICES & PAYMENTS
// ============================================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CREDIT_CARD
  OTHER
}

enum ExpenseCategory {
  SOFTWARE
  HARDWARE
  SERVICES
  TRAVEL
  MEALS
  OFFICE
  OTHER
}

model Invoice {
  id           String        @id @default(cuid())
  number       String        @unique // e.g. INV-0001
  clientId     String?
  client       Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  status       InvoiceStatus @default(DRAFT)
  issueDate    DateTime      @default(now())
  dueDate      DateTime?
  // Tax rate in basis points (500 = 5%). Totals are stored for denormalized reads.
  taxRateBps   Int           @default(0)
  subtotalCents Int          @default(0)
  taxCents     Int           @default(0)
  totalCents   Int           @default(0)
  notes        String?       @db.Text
  createdById  String?
  createdBy    User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  items    InvoiceItem[]
  payments Payment[]

  @@index([status])
  @@index([clientId])
  @@index([projectId])
  @@index([deletedAt])
  @@index([createdAt])
}

model InvoiceItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description    String
  quantity       Int     @default(1)
  unitPriceCents Int
  amountCents    Int

  @@index([invoiceId])
}

model Payment {
  id            String        @id @default(cuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amountCents   Int
  method        PaymentMethod @default(BANK_TRANSFER)
  paidAt        DateTime      @default(now())
  reference     String?
  notes         String?
  recordedById  String?
  recordedBy    User?         @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([invoiceId])
  @@index([paidAt])
}

model Expense {
  id           String          @id @default(cuid())
  amountCents  Int
  category     ExpenseCategory @default(OTHER)
  merchant     String?
  description  String?         @db.Text
  incurredAt   DateTime        @default(now())
  projectId    String?
  project      Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  recordedById String?
  recordedBy   User?           @relation("ExpenseRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?

  @@index([category])
  @@index([incurredAt])
  @@index([projectId])
  @@index([clientId])
  @@index([deletedAt])
}

// ============================================================
// MESSAGING — CONVERSATIONS & MESSAGES
// ============================================================

enum MessageSenderKind {
  USER
  CLIENT
}

model Conversation {
  id               String             @id @default(cuid())
  subject          String?
  clientId         String
  client           Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdById      String?
  createdBy        User?              @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  // Denormalized for ordering and per-side unread counts.
  lastMessageAt    DateTime           @default(now())
  lastTeamReadAt   DateTime           @default(now())
  lastClientReadAt DateTime           @default(now())
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  deletedAt        DateTime?

  messages Message[]

  @@index([clientId])
  @@index([projectId])
  @@index([lastMessageAt])
  @@index([deletedAt])
}

model Message {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String?
  sender         User?             @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  senderKind     MessageSenderKind @default(USER)
  body           String            @db.Text
  createdAt      DateTime          @default(now())
  deletedAt      DateTime?

  @@index([conversationId])
  @@index([senderKind])
  @@index([createdAt])
}

// ============================================================
// APPROVALS
// ============================================================

enum ApprovalType {
  INVOICE
  EXPENSE
  MILESTONE
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id          String         @id @default(cuid())
  type        ApprovalType
  status      ApprovalStatus @default(PENDING)
  entityId    String
  requestorId String?
  requestor   User?          @relation("ApprovalRequestor", fields: [requestorId], references: [id], onDelete: SetNull)
  decidedById String?
  decidedBy   User?          @relation("ApprovalDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  comment     String?        @db.Text
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  @@unique([type, entityId])
  @@index([status])
  @@index([type])
  @@index([requestorId])
  @@index([deletedAt])
}

// ============================================================
// TIME TRACKING
// ============================================================

model TimeEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("TimeEntryUser", fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?    @relation("TimeEntryTask", fields: [taskId], references: [id], onDelete: SetNull)
  minutes   Int
  date      DateTime @db.Date
  note      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([taskId])
  @@index([date])
  @@index([deletedAt])
}

// ============================================================
// CALENDAR
// ============================================================

model CalendarEvent {
  id          String    @id @default(cuid())
  title       String
  description String?   @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean   @default(false)
  projectId   String?
  project     Project?  @relation("CalendarEventProject", fields: [projectId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?   @relation("CalendarEventClient", fields: [clientId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?     @relation("CalendarEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([startsAt])
  @@index([projectId])
  @@index([clientId])
  @@index([createdById])
  @@index([deletedAt])
}

// ============================================================
// CONTRACTORS
// ============================================================

enum ContractorStatus {
  ACTIVE
  INACTIVE
}

model Contractor {
  id          String            @id @default(cuid())
  name        String
  email       String?           @unique
  phone       String?
  company     String?
  specialty   String?
  // Hourly rate in minor units (cents for USD). Null = not set.
  rate        Int?
  status      ContractorStatus  @default(ACTIVE)
  notes       String?           @db.Text
  createdById String?
  createdBy   User?             @relation("ContractorCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  assignments ContractorProject[]

  @@index([status])
  @@index([createdById])
  @@index([deletedAt])
}

// Many-to-many between contractors and the projects they work on.
model ContractorProject {
  contractorId String
  contractor   Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([contractorId, projectId])
  @@index([projectId])
}

// ============================================================
// FILE SHARING
// ============================================================

model SharedFile {
  id           String   @id @default(cuid())
  // Original filename shown in the UI; never used for disk paths.
  name         String
  // Relative path under the storage root on disk (server-generated).
  storageKey   String   @unique
  mimeType     String?
  // Size in bytes.
  size         Int
  projectId    String?
  project      Project? @relation("SharedFileProject", fields: [projectId], references: [id], onDelete: SetNull)
  clientId     String?
  client       Client?  @relation("SharedFileClient", fields: [clientId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?    @relation("SharedFileUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([projectId])
  @@index([clientId])
  @@index([uploadedById])
  @@index([deletedAt])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationKind {
  APPROVAL
  MESSAGE
  TASK
  FILE
  SYSTEM
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  kind       NotificationKind
  title      String
  body       String?          @db.Text
  // Client-side route to open when the notification is clicked.
  link       String?
  entityType String?
  entityId   String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())
  deletedAt  DateTime?

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([deletedAt])
}

// ============================================================
// SETTINGS
// ============================================================
model BusinessProfile {
  id                String   @id @default(cuid())
  name              String?
  logoUrl           String?
  email             String?
  phone             String?
  website           String?
  address           String?
  country           String?
  currency          String   @default("USD")
  timezone          String   @default("UTC")
  invoicePrefix     String   @default("INV")
  invoiceNextNumber Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  updatedBy         String?
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// AUDIT
// ============================================================

enum AuditAction {
  LOGIN
  LOGOUT
  LOGIN_FAILED
  PASSWORD_CHANGE
  PASSWORD_RESET
  ROLE_CHANGE
  PERMISSION_CHANGE
  CREATE
  UPDATE
  DELETE
  SOFT_DELETE
  RESTORE
  APPROVE
  REJECT
  STATUS_CHANGE
  SETTINGS_CHANGE
  EXPORT
  OTHER
}

model AuditLog {
  id        String      @id @default(cuid())
  actorId   String?
  actorType String      @default("user") // user | client | system
  action    AuditAction
  entity    String
  entityId  String?
  summary   String?
  metadata  Json?
  ip        String?
  userAgent String?
  createdAt DateTime    @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
