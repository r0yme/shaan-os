# Shaan OS — environment configuration
# Copy to .env and fill in values. NEVER commit .env.

# PostgreSQL connection string
# format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:change_me@127.0.0.1:5432/shaan_os?schema=public"

# Auth.js secret (REQUIRED, 32+ random chars)
# generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="generate_a_long_random_value"

# The canonical URL the app is served from (used by Auth.js)
AUTH_URL="http://localhost:3000"

# Google OAuth (optional — omit to disable Google sign-in)
# create at https://console.cloud.google.com/apis/credentials
# authorized redirect URI: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Application URLs
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Logging (optional)
# LOG_LEVEL=info

# AI assistant (optional — set AI_ENABLED=true + one key to activate)
# Provider: "google" (Gemini) or "openrouter" (free `:free` models)
AI_ENABLED=false
AI_PROVIDER=google
# Gemini key: https://aistudio.google.com/apikey  (free tier, no card)
GOOGLE_GENERATIVE_AI_API_KEY=""
# OpenRouter key: https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Model id (provider-specific). Examples:
#   google:    gemini-2.5-flash
#   openrouter: meta-llama/llama-3.3-70b-instruct:free
AI_MODEL=""
